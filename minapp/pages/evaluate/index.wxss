page {
  background-image: url('data:image/svg+xml;base64,');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: top center;
}

.tab-row {
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.35);
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e9d6ff;
}

.tab-item.active {
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #120b24;
  font-weight: 600;
}

.evaluate-card {
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.test-title {
  font-size: 30rpx;
  font-weight: 600;
}

.status-badge {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-todo {
  background: rgba(255, 255, 255, 0.08);
  color: #e9d6ff;
}

.status-done {
  background: linear-gradient(90deg, #ffcf71, #ff9f43);
  color: #120b24;
}

.status-repeatable {
  background: rgba(201, 169, 255, 0.18);
  color: #c9a9ff;
}

.test-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #b3a6d9;
}

.card-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
}

.chip-primary {
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #120b24;
}
