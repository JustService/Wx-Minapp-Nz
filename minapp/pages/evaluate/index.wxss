page {
  background-image: url('data:image/svg+xml;base64,');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: top center;
}

.topic-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.topic-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(124, 255, 238, 0.12);
  color: #C9A9FF;
  font-size: 24rpx;
}

.test-card {
  margin-bottom: 20rpx;
}

.test-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.test-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
