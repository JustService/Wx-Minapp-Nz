page {
  background-image: url('data:image/svg+xml;base64,');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: top center;
}

.summary {
  font-size: 28rpx;
  color: #e9d6ff;
}

.score-row {
  margin-bottom: 16rpx;
}

.score-bar {
  margin-top: 6rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
}

.score-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #9A7BFF, #C9A9FF);
}

.reward-card {
  margin-top: 24rpx;
  text-align: center;
}
