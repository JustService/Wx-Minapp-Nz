page {
  background-image: url('data:image/svg+xml;base64,');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: top center;
}

.balance-card {
  margin-bottom: 24rpx;
}

.balance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.balance-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.balance-label {
  font-size: 24rpx;
  color: #b3a6d9;
}

.balance-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #c9a9ff;
}

.balance-btn {
  border-radius: 999rpx;
  padding: 0 28rpx;
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #120b24;
  font-weight: 600;
}

.modules-card {
  margin-bottom: 24rpx;
}

.tabs-row {
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.35);
  margin-bottom: 20rpx;
}

.tab-pill {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e9d6ff;
}

.tab-pill.active {
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #120b24;
  font-weight: 600;
}

.small-title {
  margin-bottom: 16rpx;
}

.shop-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-column-gap: 18rpx;
  grid-row-gap: 18rpx;
}

.shop-item {
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(8, 14, 32, 0.7);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.shop-name {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.shop-cost {
  align-self: flex-start;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffcf71, #ff9f43);
  font-size: 22rpx;
  color: #120b24;
}

.shop-cost-unit {
  margin-left: 4rpx;
}

.coupons-card {
  margin-top: 16rpx;
}

.coupon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.coupon-row:last-child {
  border-bottom: none;
}

.coupon-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.coupon-name {
  font-size: 28rpx;
}

.coupon-expire {
  font-size: 22rpx;
  color: #b3a6d9;
}

.coupon-status {
  min-width: 100rpx;
  text-align: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.coupon-status.status-available {
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #120b24;
}

.coupon-status.status-used {
  background: rgba(255, 255, 255, 0.1);
  color: #b3a6d9;
}

.coupon-status.status-expired {
  background: rgba(255, 77, 106, 0.18);
  color: #ff9f9f;
}
