page {
  background-image: url('data:image/svg+xml;base64,');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: top center;
}

.tags-card {
  margin-bottom: 24rpx;
}

.tags-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.tags-title {
  font-size: 28rpx;
  font-weight: 600;
}

.tags-edit-btn {
  border-radius: 999rpx;
  padding: 0 24rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(124, 255, 238, 0.1);
  font-size: 22rpx;
}

.tags-hint {
  margin-top: 4rpx;
}

.partner-card {
  margin-bottom: 24rpx;
}

.partner-main {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.partner-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 20%, #c9a9ff, #1b2548);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.partner-avatar-text {
  font-size: 40rpx;
  font-weight: 600;
}

.partner-name-row {
  margin-bottom: 4rpx;
}

.partner-name {
  font-size: 30rpx;
  font-weight: 600;
}

.partner-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.partner-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(201, 169, 255, 0.12);
  font-size: 22rpx;
}

.reason-text {
  margin-top: 4rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #b3a6d9;
}

.actions-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.action-btn {
  flex: 1;
  border-radius: 999rpx;
}

.action-btn.primary {
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #120b24;
}

.action-btn.ghost {
  border: 1rpx solid #5a6bff;
  background: transparent;
  color: #c9d6ff;
}

.safety-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.safety-link {
  font-size: 22rpx;
  color: #9b8fd1;
}

.divider {
  font-size: 22rpx;
  color: #9b8fd1;
}

.team-card {
  margin-bottom: 24rpx;
}

.task-row {
  margin-bottom: 10rpx;
}

.task-title {
  font-size: 26rpx;
}
