<view class="container">
  <view class="card">
    <view class="card-title">我的兴趣标签</view>
    <view class="tag-list">
      <block wx:for="{{tags}}" wx:key="*this">
        <view class="tag">{{item}}</view>
      </block>
    </view>
    <view class="card-subtitle">可在“我的”中调整标签配置。</view>
  </view>

  <view class="card">
    <view class="card-title">推荐搭子</view>
    <block wx:for="{{recommendations}}" wx:key="name">
      <view class="buddy-card">
        <view>
          <view class="buddy-name">{{item.name}}</view>
          <view class="card-subtitle">{{item.reason}}</view>
        </view>
        <view class="buddy-actions">
          <button size="mini" class="button-primary">喜欢</button>
          <button size="mini" class="ghost">跳过</button>
        </view>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="card-title">预设招呼语</view>
    <block wx:for="{{greetings}}" wx:key="*this">
      <view class="greeting">{{item}}</view>
    </block>
  </view>
</view>
