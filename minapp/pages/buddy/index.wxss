page {
  background-image: url('data:image/svg+xml;base64,');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: top center;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(124, 255, 238, 0.1);
  color: #C9A9FF;
  font-size: 22rpx;
}

.candidate-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.ghost {
  border-radius: 999rpx;
  color: #C9A9FF;
  border: 1rpx solid #C9A9FF;
  background: transparent;
}

.greet {
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}
