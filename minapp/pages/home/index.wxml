<view class="container">
  <view class="card hero">
    <image class="hero-image" src="data:image/svg+xml;base64," mode="widthFix" />
    <view class="hero-content">
      <text class="hero-title">星穹成长营</text>
      <text class="hero-subtitle">点亮你的学习技能树</text>
    </view>
  </view>

  <view class="resource-bar">
    <view class="resource-item">
      <text class="label">积分</text>
      <text class="value">{{resources.points}}</text>
    </view>
    <view class="resource-item">
      <text class="label">成长值</text>
      <text class="value">{{resources.xp}}</text>
    </view>
    <view class="resource-item">
      <text class="label">等级</text>
      <text class="value">Lv.{{resources.level}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">主线任务</view>
    <view class="card">
      <block wx:for="{{tasks}}" wx:key="title">
        <view class="list-item">
          <view>
            <text class="task-title">{{item.title}}</text>
            <text class="hint">{{item.desc}}</text>
          </view>
          <text class="badge">{{item.status}}</text>
        </view>
      </block>
      <button class="primary-button" size="mini" data-route="/pages/growth/index" bindtap="goTo">去完成</button>
    </view>
  </view>

  <view class="section">
    <view class="section-title">快捷入口</view>
    <view class="grid">
      <block wx:for="{{quickEntries}}" wx:key="title">
        <view class="card grid-item" data-route="{{item.route}}" bindtap="goTo">
          <text class="grid-title">{{item.title}}</text>
          <text class="hint">点击进入</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-title">公告活动</view>
    <view class="card">
      <block wx:for="{{notices}}" wx:key="index">
        <view class="notice">{{item}}</view>
      </block>
    </view>
  </view>
</view>
