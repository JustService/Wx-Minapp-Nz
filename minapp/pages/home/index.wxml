<view class="container">
  <view class="card top-card">
    <view class="top-row">
      <view class="avatar-wrap">
        <text class="avatar-initial">U</text>
      </view>
      <view class="top-main">
        <text class="nickname">{{profile.nickname}}</text>
        <view class="level-badge">
          <text class="level-text">Lv. {{profile.level}}</text>
        </view>
      </view>
      <view class="top-right">
        <view class="wallet-item">
          <text class="wallet-label">积分</text>
          <text class="wallet-value">{{wallet.points}}</text>
        </view>
        <view class="wallet-item">
          <text class="wallet-label">券</text>
          <view class="wallet-ticket">
            <text class="wallet-value">{{wallet.tickets}}</text>
            <view wx:if="{{wallet.hasTicketRedDot}}" class="red-dot"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card mission-card" bindtap="goTo" data-route="/pages/evaluate/index">
    <view class="mission-left">
      <view class="section-title-inline">主线任务</view>
      <view class="mission-title">{{mainMission.title}}</view>
      <view class="mission-desc">
        <text class="hint">{{mainMission.desc}}</text>
        <text class="mission-progress-text">{{mainMission.progress}}/{{mainMission.total}}</text>
      </view>
    </view>
    <view class="mission-right">
      <view class="go-btn">GO</view>
    </view>
  </view>

  <view class="card quick-card">
    <view class="section-title-inline">快捷入口</view>
    <view class="quick-grid">
      <block wx:for="{{quickEntries}}" wx:key="title">
        <view class="quick-item" data-route="{{item.route}}" bindtap="goTo">
          <view class="quick-dot" style="background-color: {{item.color}};"></view>
          <text class="quick-title">{{item.title}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card notice-card">
    <view class="notice-title">{{notice.title}}</view>
    <text class="notice-desc">{{notice.desc}}</text>
    <view class="notice-tags">
      <block wx:for="{{notice.tags}}" wx:key="index">
        <view class="notice-tag">{{item}}</view>
      </block>
    </view>
  </view>
</view>
