.top-card {
  margin-bottom: 24rpx;
}

.top-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 20%, #c9a9ff, #1b2548);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-initial {
  font-size: 32rpx;
  font-weight: 600;
}

.top-main {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffcf71, #ff9f43);
  color: #120b24;
}

.level-text {
  font-size: 22rpx;
  font-weight: 600;
}

.top-right {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wallet-item {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.wallet-label {
  font-size: 22rpx;
  color: #9b8fd1;
}

.wallet-value {
  font-size: 26rpx;
  font-weight: 600;
}

.wallet-ticket {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.red-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff4d6a;
}

.section-title-inline {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.mission-card {
  margin-bottom: 24rpx;
}

.mission-title {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.mission-desc {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.mission-progress-text {
  font-size: 22rpx;
  color: #c9a9ff;
}

.mission-actions {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.mission-btn {
  flex: 1;
  border-radius: 999rpx;
}

.mission-btn.primary {
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #1b0d34;
}

.mission-btn.ghost {
  border: 1rpx solid #5a6bff;
  background: transparent;
  color: #c9d6ff;
}

.quick-card {
  margin-bottom: 24rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-row-gap: 18rpx;
  grid-column-gap: 18rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(8, 14, 32, 0.6);
}

.quick-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.quick-title {
  font-size: 26rpx;
}

.notice-card {
  margin-bottom: 16rpx;
}

.notice-title {
  font-size: 26rpx;
  margin-bottom: 6rpx;
}

.notice-desc {
  display: block;
  margin-bottom: 16rpx;
  color: #b3a6d9;
  font-size: 24rpx;
}

.notice-tags {
  display: flex;
  gap: 12rpx;
}

.notice-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(154, 123, 255, 0.16);
  font-size: 22rpx;
}

page {
  background-image: url("https://ipets.haott.com/static/minapp/images/home.jpg");
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center center;
}
