<view class="container">
  <view class="card profile-card">
    <view class="profile-main">
      <view class="avatar"></view>
      <view class="profile-text">
        <view class="name">{{profile.name}}</view>
        <view class="stats-row">
          <text class="hint">Lv. {{profile.level}}</text>
          <text class="hint">· 积分 {{profile.points}}</text>
          <text class="hint">· 抽奖券 {{profile.tickets}}</text>
        </view>
      </view>
    </view>
    <button class="edit-btn" size="mini">编辑资料</button>
  </view>

  <view class="card">
    <block wx:for="{{menu}}" wx:key="title">
      <view class="menu-item" data-route="{{item.route}}" bindtap="goTo">
        <view class="menu-main">
          <text>{{item.title}}</text>
          <text class="menu-desc hint">{{item.desc}}</text>
        </view>
        <text class="menu-value hint">{{item.value}}</text>
      </view>
    </block>
  </view>
</view>
