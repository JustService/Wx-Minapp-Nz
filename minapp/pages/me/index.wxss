.profile {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.menu-title {
  font-size: 26rpx;
  font-weight: 600;
}

.chevron {
  font-size: 30rpx;
  color: #c8b7ff;
}
