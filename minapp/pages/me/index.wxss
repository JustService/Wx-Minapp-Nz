page {
  background-image: url('data:image/svg+xml;base64,');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: top center;
}

.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: radial-gradient(circle at top, #C9A9FF, #1f2b52);
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.profile-card {
  margin-bottom: 24rpx;
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.profile-text {
  flex: 1;
}

.stats-row {
  margin-top: 6rpx;
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.edit-btn {
  align-self: flex-start;
  border-radius: 999rpx;
  padding: 0 32rpx;
  background: linear-gradient(90deg, #9a7bff, #c9a9ff);
  color: #120b24;
  font-weight: 600;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.menu-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-desc {
  font-size: 22rpx;
}

.menu-item:last-child {
  border-bottom: none;
}
