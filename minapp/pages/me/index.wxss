.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: radial-gradient(circle at top, #7cffee, #1f2b52);
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.menu-item:last-child {
  border-bottom: none;
}
