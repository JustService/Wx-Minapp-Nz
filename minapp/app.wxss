page {
  background: #120a23;
  color: #f7f5ff;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: linear-gradient(135deg, rgba(110, 63, 243, 0.22), rgba(27, 17, 48, 0.9));
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(61, 31, 145, 0.35);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #d4c9ff;
}

.badge {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(167, 107, 255, 0.2);
  color: #d9ccff;
  font-size: 22rpx;
}

.button-primary {
  background: linear-gradient(90deg, #7a4bff, #a76bff);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  font-weight: 600;
}

.grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.grid-item {
  flex: 1 1 45%;
  min-width: 280rpx;
}
