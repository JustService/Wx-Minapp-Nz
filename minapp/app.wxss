page {
  background-color: #0c1226;
  color: #e8eeff;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.container {
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #c9f7ff;
  margin-bottom: 20rpx;
}

.card {
  background: linear-gradient(135deg, rgba(28, 40, 74, 0.9), rgba(16, 24, 44, 0.9));
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
  border: 1rpx solid rgba(124, 255, 238, 0.15);
}

.badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(124, 255, 238, 0.15);
  color: #7cffee;
  font-size: 22rpx;
}

.primary-button {
  margin-top: 20rpx;
  background: linear-gradient(90deg, #44d9ff, #7cffee);
  color: #08101f;
  border-radius: 999rpx;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-item {
  flex: 1 1 45%;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.hint {
  color: #93a6d6;
  font-size: 24rpx;
}
