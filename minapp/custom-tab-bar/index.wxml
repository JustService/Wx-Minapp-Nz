<view class="tab-bar">
  <block wx:for="{{list}}" wx:key="pagePath">
    <view
      class="tab-item {{index === selected ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <view class="tab-icon icon-{{item.key}}"></view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </block>
</view>
