.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #120b24;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -8rpx 16rpx rgba(0, 0, 0, 0.4);
  z-index: 99;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9b8fd1;
  font-size: 20rpx;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-bottom: 4rpx;
  background: rgba(155, 143, 209, 0.28);
}

.tab-item.active {
  color: #c9a9ff;
}

.tab-item.active .tab-icon {
  background: linear-gradient(135deg, #9a7bff, #c9a9ff);
}

.tab-text {
  line-height: 1;
}

